# ---------------------------------------------------------------------------
# Every variable the stack reads. Copy to .env for local work:  cp .env.example .env
# docker-compose has working defaults for all of these, so `docker compose up`
# works with no .env at all. Nothing here is a real secret.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_USER=peblo
POSTGRES_PASSWORD=peblo
POSTGRES_DB=peblo
# The API's own connection string. Uses the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://peblo:peblo@db:5432/peblo

# --- Auth -----------------------------------------------------------------
# Signs the JWTs. Rotating it signs everyone out, which is the intended blast radius.
JWT_SECRET=dev-only-not-a-real-secret
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=720

# Seeded demo accounts. In any real environment these are not created at all —
# see AUTO_SEED below.
SEED_ADMIN_EMAIL=admin@peblo.tv
SEED_ADMIN_PASSWORD=peblo-admin
SEED_EDITOR_EMAIL=editor@peblo.tv
SEED_EDITOR_PASSWORD=peblo-editor

# --- Storage --------------------------------------------------------------
# local | r2
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/storage
# Where a browser fetches artwork from. With STORAGE_BACKEND=local the API
# serves it at /media; with r2 this is the CDN domain.
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media

# Only read when STORAGE_BACKEND=r2.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=peblo-tv-catalogue
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://cdn.peblo.tv

# --- Content --------------------------------------------------------------
REFERENCE_PATH=/data/seed/reference.json
SEED_PATH=/data/seed/seed_shows.json
SEED_ASSETS_DIR=/data/assets
# Imports seed_shows.json and creates the demo accounts on an empty database.
# Set to false everywhere except local and CI.
AUTO_SEED=true
# Runs one publish after seeding so a fresh stack has a populated viewer.
AUTO_PUBLISH_ON_SEED=true

# --- HTTP -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ENVIRONMENT=local

# --- Frontends (read by Vite at BUILD time, not run time) -----------------
VITE_API_BASE_URL=http://localhost:8000
VITE_VIEWER_URL=http://localhost:5174
